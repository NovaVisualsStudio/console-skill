# Godot editor cache and imported assets
.godot/
# Generated exports
build/
*.apk
*.aab

# Free CC0 3D binaries are fetched by tools/fetch_cc0_animations.py
assets/characters/quaternius-standard-male.glb
assets/animations/*.glb
assets/animations/LICENSE-UAL2-CC0.txt

# CharacterCreator generated CC0 human, hair and outfit binaries
assets/characters/charactercreator-*.glb

# 1K CC0 Poly Haven texture binaries are fetched and checksum-verified by CI
assets/textures/*_1k.jpg
\n# Godot importer sidecars for fetched PBR maps are generated by the asset fetcher\nassets/textures/*.jpg.import\n